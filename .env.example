# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copiar a `.env.local` y completar.
#   cp .env.example .env.local
#
# ⚠️ Ojo: el `.env.local` que hay en los worktrees apunta al Supabase **LOCAL**
# (127.0.0.1). Varios `scripts/*.mjs` lo leen y dan ECONNREFUSED/401 contra
# prod. Para correr scripts contra el Supabase hosted, pasar host + service key
# a mano en la línea de comando, o usar `.env.prod-readonly.local`
# (`npm run dev:prod-readonly`, puerto 3002).
#
# Fuente de verdad de qué está seteado en prod: Vercel → Project → Env Vars.
# Generado desde los `process.env.*` del código el 2026-09-10.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obligatorio) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Formato nuevo `sb_secret_…`. Bypassea RLS: nunca exponer al browser.
SUPABASE_SERVICE_KEY=
# Cifrado de PII de leads (lib/leads-crypto.ts) + endpoint interno de descifrado
LEADS_ENCRYPTION_KEY=
INTERNAL_DECRYPT_TOKEN=

# ── Crons de Vercel (obligatorio) ────────────────────────────────────────────
# Autentica /api/cron/*. Sin esto los crons de vercel.json se rechazan.
CRON_SECRET=

# ── LinkedIn · Unipile ───────────────────────────────────────────────────────
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=

# ── Email · Instantly ────────────────────────────────────────────────────────
INSTANTLY_API_KEY=
# ⚠️ type=Secret en Vercel: irrecuperable una vez guardado. Guardar copia aparte.
INSTANTLY_WEBHOOK_SECRET=
INSTANTLY_WEBHOOK_REPLIES=
# Sólo para debug local. NUNCA en prod: saltea la validación de firma.
INSTANTLY_WEBHOOK_ALLOW_INSECURE=

# ── Llamadas · Aircall ───────────────────────────────────────────────────────
AIRCALL_API_ID=
AIRCALL_API_TOKEN=
AIRCALL_WEBHOOK_SECRET=
AIRCALL_DEFAULT_NUMBER_ID=
NEXT_PUBLIC_AIRCALL_DEFAULT_USER_ID=
# LAW: las llamadas son MANUALES. Dejar apagado.
ENABLE_AUTO_DIAL=

# ── AI ───────────────────────────────────────────────────────────────────────
# LAW: la generación de mensajes va por n8n, no Next.js → proveedor directo.
# Estas keys son para features de análisis/coaching, no para generar outreach.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_API_BASE_URL=https://n8n.srv949269.hstgr.cloud

# ── Odoo (destino de leads positivos) ────────────────────────────────────────
ODOO_URL=https://swlconsulting-swlodoo.odoo.com
ODOO_DB=
ODOO_UID=
ODOO_API_KEY=
ODOO_STAGE_PROSPECT=

# ── Notificaciones ───────────────────────────────────────────────────────────
# Sin VAPID_* las web push son no-op (silenciosas, no fallan).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sales@swlconsulting.com
# Sin APP_BASE_URL los links de los mails de recordatorio apuntan al default.
APP_BASE_URL=https://app.swlconsulting.com
SMTP_USER=sales@swlconsulting.com
SMTP_PASS=
REPORT_RECIPIENTS=

# ── Otros ────────────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
# Identidad canónica de llamadas. Borrar la variable = rollback.
CALLS_CANONICAL_IDENTITY=1
# ⚠️ Saltea auth. Sólo para previews. Jamás en prod.
NEXT_PUBLIC_PREVIEW_NO_AUTH=

# ─────────────────────────────────────────────────────────────────────────────
# Sólo para scripts de `scripts/` (no las lee la app):
#   SUPABASE_URL              — los scripts la mapean a NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY — alias de fallback de SUPABASE_SERVICE_KEY
#   APP_URL                   — base para capture-authenticated.mts (def: :3002)
#   HARNESS_TENANT_ID · QA_TENANT · SHOTS_DIR · SHOT_FROM · SHOT_TO
# ─────────────────────────────────────────────────────────────────────────────
